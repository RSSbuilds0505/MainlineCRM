# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Postgres, transaction pooler URI (Project Settings > Database)
DATABASE_URL=
# Public URL of the app, e.g. https://mainline.vercel.app
APP_URL=
# First owner account created by the seed script
OWNER_EMAIL=
OWNER_NAME=
# Optional: transactional email (sign-in links and alerts)
RESEND_API_KEY=
EMAIL_FROM="Mainline <notifications@yourdomain.com>"
# Set true only after a real verification email is received.
EMAIL_DELIVERY_VERIFIED=false
EMAIL_TEST_TO=
# Optional: AI triage
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Optional: Slack incoming webhook for escalations and new tickets
SLACK_WEBHOOK_URL=
# Protects the scheduled sweep endpoint
CRON_SECRET=

# Customer installation branding (set before building)
NEXT_PUBLIC_APP_NAME=Mainline
NEXT_PUBLIC_COMPANY_NAME="Rogers Systems Solutions"
NEXT_PUBLIC_BRAND_ATTRIBUTION="by RSS"
